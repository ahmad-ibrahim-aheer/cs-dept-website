---
import Layout from '../../layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import '../../styles/global.css';
---

<Layout>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="py-20 relative overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-gray-950 via-gray-900 to-gray-950"
      >
      </div>
      <div class="absolute inset-0 grid-pattern opacity-10"></div>

      <div class="container mx-auto px-6 relative z-10 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">
          <span
            class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
          >
            Academic Calendar 2026-27
          </span>
        </h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Stay informed with important dates, deadlines, and academic milestones
          for the 2026-27 academic year
        </p>
      </div>
    </section>

    <!-- Academic Calendar -->
    <section class="py-20 bg-gradient-to-b from-gray-900 to-gray-950">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Fall Semester -->
            <div
              class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm border border-gray-700 rounded-2xl p-10"
            >
              <h3
                class="text-2xl font-bold text-blue-400 mb-6 flex items-center"
              >
                <svg
                  class="w-6 h-6 mr-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                Fall Semester 2026
              </h3>
              <div class="space-y-4">
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-blue-500/20 to-blue-600/10 rounded-lg p-3 border border-blue-500/30"
                >
                  <span class="text-white font-semibold"
                    >Commencement of Classes</span
                  >
                  <div class="flex flex-col items-end space-y-1">
                    <span class="text-blue-300 font-bold text-lg">Sep 01</span>
                    <span class="text-blue-300 font-bold text-lg"
                      >Sep 07 for 1st Semester</span
                    >
                  </div>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Deadline to enroll/change the courses</span
                  >
                  <span class="text-blue-400 font-medium">Sep 14</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Deadline to withdraw any course</span
                  >
                  <span class="text-blue-400 font-medium">Sep 25</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Deadline for submission of MS/MPhil/MSc(Hons)/PhD thesis
                    (for students admitted in Fall session)</span
                  >
                  <span class="text-blue-400 font-medium">Sep 30</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-orange-500/20 to-orange-600/10 rounded-lg p-3 border border-orange-500/30"
                >
                  <span class="text-white font-semibold"
                    >Mid Term Examination***</span
                  >
                  <span class="text-orange-300 font-bold text-lg"
                    >Nov 02-06</span
                  >
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Iqbal Day*</span>
                  <span class="text-blue-400 font-medium">Nov 09</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Quaid-e-Azam Day*</span>
                  <span class="text-blue-400 font-medium">Dec 25</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-red-500/20 to-red-600/10 rounded-lg p-3 border border-red-500/30"
                >
                  <span class="text-white font-semibold"
                    >Final Term Examinations***</span
                  >
                  <span class="text-red-300 font-bold text-lg">Jan 04-12</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Declaration of Result</span>
                  <span class="text-blue-400 font-medium">Jan 18</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Submission of Six Monthly report by PhD &
                    MS/MPhil/MSc(Hons) scholars (From July to December)</span
                  >
                  <span class="text-blue-400 font-medium">Jan 15</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Comprehensive Examination of PhD</span
                  >
                  <span class="text-blue-400 font-medium">Jan 13-15</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-300">Semester Break for students</span>
                  <span class="text-blue-400 font-medium">Jan 19-29</span>
                </div>
              </div>
            </div>

            <!-- Spring Semester -->
            <div
              class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm border border-gray-700 rounded-2xl p-10"
            >
              <h3
                class="text-2xl font-bold text-purple-400 mb-6 flex items-center"
              >
                <svg
                  class="w-6 h-6 mr-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                Spring Semester 2027
              </h3>
              <div class="space-y-4">
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-purple-500/20 to-purple-600/10 rounded-lg p-3 border border-purple-500/30"
                >
                  <span class="text-white font-semibold"
                    >Commencement of Classes</span
                  >
                  <span class="text-purple-300 font-bold text-lg">Feb 01</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Kashmir Solidarity Day*</span>
                  <span class="text-purple-400 font-medium">Feb 05</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Deadline to enroll/change the courses</span
                  >
                  <span class="text-purple-400 font-medium">Feb 09</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Deadline to withdraw any course</span
                  >
                  <span class="text-purple-400 font-medium">Feb 26</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300"
                    >Deadline for submission of MS/MPhil/MSc(Hons)/PhD thesis
                    (for students admitted in Spring session)</span
                  >
                  <span class="text-purple-400 font-medium">Mar 01</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Eid-ul-Fitr**</span>
                  <span class="text-purple-400 font-medium">Mar 09-11</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Pakistan Day Celebrations*</span>
                  <span class="text-purple-400 font-medium">Mar 23</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-orange-500/20 to-orange-600/10 rounded-lg p-3 border border-orange-500/30"
                >
                  <span class="text-white font-semibold"
                    >Mid Term Examination***</span
                  >
                  <span class="text-orange-300 font-bold text-lg"
                    >Mar 29-Apr 02</span
                  >
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Labor Day*</span>
                  <span class="text-purple-400 font-medium">May 01</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Eid-ul-Azha**</span>
                  <span class="text-purple-400 font-medium">May 16-18</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Yaum-i-Takbeer*</span>
                  <span class="text-purple-400 font-medium">May 28</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-red-500/20 to-red-600/10 rounded-lg p-3 border border-red-500/30"
                >
                  <span class="text-white font-semibold"
                    >Final Term Examination***</span
                  >
                  <span class="text-red-300 font-bold text-lg">Jun 03-11</span>
                </div>
                <div
                  class="flex justify-between items-center border-b border-gray-700 pb-3"
                >
                  <span class="text-gray-300">Youm-e-Ashura**</span>
                  <span class="text-purple-400 font-medium">Jun 15</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-300">Declaration of Result</span>
                  <span class="text-purple-400 font-medium">Jun 18</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Summer Programs -->
          <div
            class="mt-8 bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm border border-gray-700 rounded-2xl p-10"
          >
            <h3 class="text-2xl font-bold text-cyan-400 mb-6 flex items-center">
              <svg
                class="w-6 h-6 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
              Summer Semester 2027
            </h3>
            <div class="space-y-4 mb-6">
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3"
              >
                <span class="text-gray-300"
                  >Registration and Submission of Fee</span
                >
                <span class="text-cyan-400 font-medium">Jun 21-26</span>
              </div>
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-cyan-500/20 to-cyan-600/10 rounded-lg p-3 border border-cyan-500/30"
              >
                <span class="text-white font-semibold"
                  >Commencement of Classes for Summer Semester</span
                >
                <span class="text-cyan-300 font-bold text-lg">Jun 28</span>
              </div>
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3"
              >
                <span class="text-gray-300"
                  >Comprehensive Examination of PhD</span
                >
                <span class="text-cyan-400 font-medium">Jul 05-09</span>
              </div>
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3"
              >
                <span class="text-gray-300"
                  >Submission of Six Monthly report by PhD & MS/MPhil/MSc(Hons)
                  scholars (From January to June)</span
                >
                <span class="text-cyan-400 font-medium">Jul 16</span>
              </div>
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-orange-500/20 to-orange-600/10 rounded-lg p-3 border border-orange-500/30"
              >
                <span class="text-white font-semibold"
                  >Mid Term Examination***</span
                >
                <span class="text-orange-300 font-bold text-lg">Jul 26-30</span>
              </div>
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3"
              >
                <span class="text-gray-300">Independence Day*</span>
                <span class="text-cyan-400 font-medium">Aug 14</span>
              </div>
              <div
                class="flex justify-between items-center border-b border-gray-700 pb-3 bg-gradient-to-r from-red-500/20 to-red-600/10 rounded-lg p-3 border border-red-500/30"
              >
                <span class="text-white font-semibold"
                  >Final Term Examination***</span
                >
                <span class="text-red-300 font-bold text-lg">Aug 23-27</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-300">Declaration of Result</span>
                <span class="text-cyan-400 font-medium">Aug 31</span>
              </div>
            </div>
          </div>

          <!-- Important Notes -->
          <div
            class="mt-8 bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm border border-gray-700 rounded-2xl p-10"
          >
            <p class="text-sm text-gray-400 mb-4">
              <strong class="text-cyan-400">Note:</strong> Summer Semester will be
              offered for undergraduate programs only.
            </p>
            <div class="text-sm text-gray-400 space-y-2">
              <p>
                <strong class="text-yellow-400">*</strong> Subject to declaration
                of holiday by the Government of Punjab
              </p>
              <p>
                <strong class="text-yellow-400">**</strong> Subject to appearance
                of moon
              </p>
              <p>
                <strong class="text-yellow-400">***</strong> Off days may be included
                for examination if required
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Smooth scrolling and animations
  document.addEventListener('DOMContentLoaded', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const element = entry.target as HTMLElement;
          element.style.opacity = '1';
          element.style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);

    // Observe all sections
    document.querySelectorAll('section').forEach((section) => {
      const element = section as HTMLElement;
      element.style.opacity = '0';
      element.style.transform = 'translateY(30px)';
      element.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(section);
    });
  });
</script>
